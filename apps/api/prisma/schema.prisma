generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  code      String   @default("M") // 商家编号（1位字母）
  type      String   @default("mobile")
  phone     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  dishes   Dish[]
  orders   Order[]
  promotions Promotion[]
  users    User[]
}

model NightMarket {
  id        String   @id @default(cuid())
  name      String
  address   String?
  lat       Float
  lng       Float
  radius    Int      @default(200) // meters
  city      String?
  status    String   @default("active")
  branches  Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id            String   @id @default(cuid())
  merchantId    String
  nightMarketId String?
  name          String
  code          String   @default("B") // 分店编号（1位字母）
  address       String?
  lat           Float?
  lng           Float?
  logoUrl       String?
  bannerUrl     String?
  status        String   @default("active")

  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  nightMarket NightMarket? @relation(fields: [nightMarketId], references: [id])
  categories Category[]
  tables     Table[]
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String @id @default(cuid())
  branchId String
  name     String
  sort     Int    @default(0)

  branch Branch @relation(fields: [branchId], references: [id])
  dishes Dish[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dish {
  id          String         @id @default(cuid())
  merchantId  String
  categoryId  String
  name        String
  price       Float
  image       String?
  desc        String?
  specsPreset String         @default("none")
  status      String         @default("active")

  merchant   Merchant       @relation(fields: [merchantId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  promotions PromotionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id       String @id @default(cuid())
  branchId String
  label    String
  qrCode   String?

  branch Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  merchantId String?
  phone     String   @unique
  name      String?
  avatar    String?
  status    String   @default("active")

  merchant  Merchant? @relation(fields: [merchantId], references: [id])
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         String   @id @default(cuid())
  branchId   String
  merchantId String
  tableId    String?
  userId     String?
  orderType  String   @default("takeaway")
  orderNumber String
  status     String   @default("pending")
  totalPrice Float
  customerName String?
  customerPhone String?
  userAvatar String?
  note       String?

  branch   Branch   @relation(fields: [branchId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  items    OrderItem[]
  promotions OrderPromotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  dishId   String
  name     String
  price    Float
  quantity Int
  specs    String?

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model Promotion {
  id         String   @id @default(cuid())
  merchantId String
  name       String
  type       String   // full_reduction | welfare_item | buy_get | time_discount
  rules      String   // JSON string
  startDate  DateTime?
  endDate    DateTime?
  status     String   @default("draft") // draft | active | paused | ended

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  items    PromotionItem[]
  orders   OrderPromotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionItem {
  id         String @id @default(cuid())
  promotionId String
  dishId     String
  promoPrice Float?
  limitType  String @default("per_order") // none | per_order | global_promo
  maxQty     Int    @default(1)

  promotion Promotion @relation(fields: [promotionId], references: [id])
  dish      Dish      @relation(fields: [dishId], references: [id])

  createdAt DateTime @default(now())
}

model OrderPromotion {
  id           String @id @default(cuid())
  orderId      String
  promotionId  String
  discount     Float  @default(0)
  metadata     String? // JSON string

  order     Order     @relation(fields: [orderId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])

  createdAt DateTime @default(now())
}
